# Server Configuration
PORT=3001
NODE_ENV=development
TRUST_PROXY=true
API_VERSION=v1
BACKEND_URL=https://trendorabay-platform.onrender.com

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=trendorabay
DB_CONNECTION_LIMIT=100

# Database SSL/TLS Configuration (IMPORTANT: Enable in production!)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Database Read Replica Configuration (Optional - for scaling)
DB_READ_REPLICA_HOST=
DB_READ_REPLICA_PORT=3306
DB_READ_REPLICA_USER=
DB_READ_REPLICA_PASSWORD=
DB_READ_REPLICA_NAME=
DB_READ_REPLICA_CONNECTION_LIMIT=50
DB_READ_REPLICA_SSL=true
DB_READ_REPLICA_SSL_REJECT_UNAUTHORIZED=true

# Redis Configuration (for caching and distributed rate limiting)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
ENABLE_REDIS=true

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:5173

# JWT Configuration (IMPORTANT: Use strong random secret in production!)
JWT_SECRET=your_jwt_secret_here_use_strong_random_string
JWT_EXPIRE=30d

# File Upload Configuration
UPLOADS_PATH=./uploads
MAX_FILE_SIZE=52428800

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_MAX=10

# Cache Configuration
CACHE_TTL=300

# CMS Configuration (for serving uploaded images)
CMS_URL=https://trendorabay-content-management-system.onrender.com

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Analytics 4 Configuration
GA_PROPERTY_ID=your_ga4_property_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
